# Server-side OAuth (Authorization Code Flow). None of these are
# NEXT_PUBLIC_ — they must never reach the client bundle.

# Google Cloud Console > APIs & Services > Credentials > your OAuth client
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# 32 random bytes, base64-encoded (AES-256-GCM key for the refresh-token
# cookie). Generate with: openssl rand -base64 32
AUTH_COOKIE_SECRET=

# Canonical origin this app is served from — used to build the OAuth
# redirect_uri, not derived from the request's Host header (avoids
# www/apex mismatches). No trailing slash.
# Production example: https://mindtodo.app
# Local development:  http://localhost:3000
APP_URL=http://localhost:3000
